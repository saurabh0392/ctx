{
  "name": "ctx-report-intake",
  "version": "1.0.0",
  "private": true,
  "description": "AWS intake for the ctx dashboard Report-an-issue modal: presigned S3 for images, GitHub issue creation with a PAT from SSM.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth -c githubRepo=example/private-feedback",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy"
  },
  "devDependencies": {
    "aws-cdk": "2.1132.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.1"
  },
  "dependencies": {
    "aws-cdk-lib": "2.261.0",
    "constructs": "^10.3.0",
    "@aws-sdk/client-ssm": "^3.637.0",
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/s3-presigned-post": "^3.637.0",
    "@aws-sdk/s3-request-presigner": "^3.637.0"
  }
}
