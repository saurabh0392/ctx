# Copy to .env and fill in. .env is gitignored; never commit real tokens.

# Linear personal access token, used only by tools/status-server.mjs to refresh
# the roadmap pipeline (make roadmap) live from the ctx team. Stays server-side.
# Create one at https://linear.app/settings/account/security
LINEAR_PAT=

# GitHub token, used for opening PRs from the agent. Prefer a fine-grained token
# scoped to this repo with Contents: read and Pull requests: read/write.
GITHUB_PAT=
